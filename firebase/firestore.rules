rules_version = '2';

// DENEGAR TODO por defecto. Ningún cliente escribe: todo pasa por el Worker (cuenta de servicio,
// que no se rige por estas reglas). Solo hay lecturas acotadas por rol.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- funciones ----
    function perfilPath(uid) { return /databases/$(database)/documents/usuarios/$(uid); }
    function conSesion() {
      return request.auth != null && request.auth.token.rol in ['guardia', 'supervisor', 'admin'];
    }
    // Cuenta ACTIVA: el perfil existe, está activo y su rol coincide con el claim del token.
    // Así, dar de baja a alguien corta sus lecturas AL INSTANTE aunque su ID token siga vigente.
    function activo() {
      return conSesion()
        && exists(perfilPath(request.auth.uid))
        && get(perfilPath(request.auth.uid)).data.activo == true
        && get(perfilPath(request.auth.uid)).data.rol == request.auth.token.rol;
    }
    function esAdmin() { return activo() && request.auth.token.rol == 'admin'; }
    function esSupervisor() { return activo() && request.auth.token.rol == 'supervisor'; }
    function esGuardia() { return activo() && request.auth.token.rol == 'guardia'; }

    // Todo lo no mencionado abajo (credenciales, ajustes y colecciones de fases futuras) está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }

    // Perfiles: cada quien el suyo; el admin todos; el supervisor solo guardias (para asignar turnos).
    match /usuarios/{uid} {
      allow get: if activo() && (request.auth.uid == uid || esAdmin()
                    || (esSupervisor() && resource.data.rol == 'guardia'));
      allow list: if esAdmin() || (esSupervisor() && resource.data.rol == 'guardia');
      allow create, update, delete: if false;
    }

    // Sitios: admin todos; supervisor los suyos; guardia solo los de sus turnos vigentes (get, no list).
    match /sitios/{sitioId} {
      allow get: if esAdmin()
                 || (esSupervisor() && resource.data.supervisorUid == request.auth.uid)
                 || (esGuardia() && sitioId in get(perfilPath(request.auth.uid)).data.get('sitiosAsignados', []));
      allow list: if esAdmin()
                  || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Turnos: admin todos; supervisor los de sus sitios (supervisorUid denormalizado); guardia solo los suyos.
    match /turnos/{turnoId} {
      allow get, list: if esAdmin()
                       || (esSupervisor() && resource.data.supervisorUid == request.auth.uid)
                       || (esGuardia() && resource.data.guardiaUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---- Fase 3: asistencia ----
    // Marcas (entrada/salida): inmutables; las lee el admin y su propio guardia. Los supervisores
    // consultan los resultados en 'asistencias' y las selfies pasan SOLO por el Worker.
    match /marcas/{marcaId} {
      allow get, list: if esAdmin() || (esGuardia() && resource.data.guardiaUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Resultados calculados por el Worker (retardo, falta, extras, relevo).
    match /asistencias/{turnoId} {
      allow get, list: if esAdmin()
                       || (esSupervisor() && resource.data.supervisorUid == request.auth.uid)
                       || (esGuardia() && resource.data.guardiaUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Ajustes (correcciones con motivo) y autorizaciones (extras, cierre sin relevo): inmutables.
    match /ajustesAsistencia/{ajusteId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /autorizaciones/{autId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---- Fase 4: rondines ----
    // Puntos de control y programación: admin y supervisor del sitio (supervisorUid denormalizado).
    // El guardia NO los lee: el Worker le entrega solo lo necesario de su rondín en curso.
    match /puntos/{puntoId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /programasRondin/{sitioId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Resultado calculado de cada rondín (estado, puntos con su hora): admin, supervisor del sitio y su guardia.
    match /rondines/{rondinId} {
      allow get, list: if esAdmin()
                       || (esSupervisor() && resource.data.supervisorUid == request.auth.uid)
                       || (esGuardia() && resource.data.guardiaUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // Escaneos (GPS, nota y ruta de la foto) y ajustes: inmutables. Los supervisores ven el detalle en 'rondines'
    // y las fotos pasan SOLO por el Worker.
    match /escaneos/{escaneoId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /ajustesRondin/{ajusteId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ---- Fase 5: incidencias, visitantes y bitácora ----
    // Los registros originales (incidencias, entradas/salidas de visitantes, novedades, seguimientos) son
    // inmutables y solo los lee el admin. Supervisor y guardia consultan los RESÚMENES calculados por el Worker.
    // Las fotos pasan SOLO por el Worker. El guardia lee visitantes y bitácoras vía Worker (con turno activo).
    match /incidencias/{incId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /seguimientosIncidencia/{segId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /incidenciasResumen/{incId} {
      allow get, list: if esAdmin()
                       || (esSupervisor() && resource.data.supervisorUid == request.auth.uid)
                       || (esGuardia() && resource.data.guardiaUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /visitantes/{visId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /salidasVisitante/{visId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /visitantesVista/{visId} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /novedades/{novId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }

    // ---- Fase 6: sin conexión, pánico y panel en vivo ----
    // Alertas de pánico: la ORIGINAL (panicos) es inmutable y solo la lee el admin. Su estado visible (panicoVista:
    // activa/atendida, quién y cuándo) lo lee en TIEMPO REAL solo el admin o el supervisor de ESE sitio
    // (supervisorUid denormalizado). Las consultas del panel en vivo tienen que filtrar por supervisorUid: una consulta
    // que pueda devolver datos de otros sitios se rechaza completa. El guardia no lee alertas.
    match /panicos/{id} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    match /panicoVista/{id} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /atencionesPanico/{id} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
    // Registros capturados sin conexión: bandeja de revisión (supervisor del sitio o admin) y decisiones inmutables.
    // registrosOffline (claves de idempotencia), pushSuscripciones y pushEnviados: SOLO el Worker (cerradas por defecto).
    match /offlineVista/{id} {
      allow get, list: if esAdmin() || (esSupervisor() && resource.data.supervisorUid == request.auth.uid);
      allow create, update, delete: if false;
    }
    match /revisionesOffline/{id} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }

    match /configuracion/{docId} {
      allow get: if esAdmin();
      allow list, create, update, delete: if false;
    }

    // Bitácora: solo lectura para el admin; inmutable (nadie escribe desde el cliente).
    match /auditoria/{evtId} {
      allow get, list: if esAdmin();
      allow create, update, delete: if false;
    }
  }
}
